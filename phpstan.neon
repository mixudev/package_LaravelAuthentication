includes:
    - vendor/phpstan/phpstan/conf/bleedingEdge.neon

parameters:
    level: 8
    paths:
        - src
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        # Eloquent static methods require Larastan to resolve; pre-existing pattern
        - '#Call to an undefined static method Vendor\\LaravelAuthentication\\Models\\.*::(where|create|firstOrCreate|updateOrCreate|find|findOrFail|latest|first)\(\)#'
        # Socialite optional dependency — not installed in composer.json
        - '#Class Laravel\\Socialite\\.*#'
        - '#PHPDoc tag @var for variable \$factory contains unknown class Laravel\\Socialite#'
        - '#Call to method driver\(\) on an unknown class Laravel\\Socialite\\Contracts\\Factory#'
        # Socialite method chains on unresolved class-string|object
        - '#Cannot call method (driver|scopes|stateless|redirectUrl|user)\(\) on class-string\|object#'
        # Pre-existing: array|string header() return value from Illuminate Request::header() and trans()
        - '#Cannot cast array\|string to string#'
        - '#Cannot cast array\|string\|null to string#'
        - '#Cannot cast array\|bool\|float\|int\|string\|null to string#'
        # Pre-existing: cannot cast object to string (TokenService)
        - '#Cannot cast object to string#'
        # Pre-existing: missingType.iterableValue on CaptchaDriverInterface and implementations
        - '#.*renderWidget\(\) has parameter \$options with no value type specified in iterable type array#'
        # Pre-existing: AuthenticationResult metadata array
        - '#Method Vendor\\LaravelAuthentication\\DTO\\AuthenticationResult::(success|failed)\(\) has parameter \$metadata with no value type specified#'
        # Pre-existing: RecaptchaDriver property only written
        - '#Property Vendor\\LaravelAuthentication\\Services\\Captcha\\RecaptchaDriver::\$version is never read#'
        # Pre-existing: Application config offset access in ServiceProvider
        - '#Cannot access offset .config. on Illuminate\\Contracts\\Foundation\\Application#'
        # Pre-existing: PHPDoc var tag mismatch in ServiceProvider
        - '#Variable \$file in PHPDoc tag @var does not match assigned variable \$iterator#'
        # Pre-existing: InvalidCredentialsException message param from header() returning array|string
        - '~\$message of class Vendor\\LaravelAuthentication\\Exceptions\\.*Exception constructor expects string, array\|string given~'
        # Pre-existing: ValidCaptcha closure parameter from header() returning array|string
        - '~Parameter #1 of closure expects string, array\|string given~'
